# ==============================================================================
# SMARTCROP AI — TEMPLATE ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# SERVER CONFIGURATION
PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# DATABASE CONFIGURATION (MYSQL / POSTGRESQL / RENDER CLOUD DB)
SPRING_DATASOURCE_URL=jdbc:mysql://<DB_HOST>:<DB_PORT>/<DB_NAME>?useSSL=true&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=<DB_USER>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# JPA AUTO UPDATE
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# BREVO SMTP EMAIL CONFIGURATION
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<YOUR_BREVO_SMTP_USERNAME>
SPRING_MAIL_PASSWORD=<YOUR_BREVO_SMTP_PASSWORD>
SPRING_MAIL_FROM=<YOUR_VERIFIED_SENDER_EMAIL>

# SECURITY & JWT SECRET
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars

# CORS ALLOWED ORIGINS (COMMA-SEPARATED)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.onrender.com

# FRONTEND CLIENT API BASE URL
VITE_API_BASE_URL=https://<YOUR_RENDER_BACKEND_SERVICE_NAME>.onrender.com/api
